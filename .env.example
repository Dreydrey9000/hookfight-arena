# ─────────────────────────────────────────────────────────────
# HookFight Arena — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# Dev keys only in here — production keys live in Vercel/Convex dashboards.
# ─────────────────────────────────────────────────────────────

# --- Convex (typed database) ---
# Created by `npx convex dev` on first run; it writes these for you.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Auth: Convex Auth (built-in, @convex-dev/auth) ---
# Convex Auth keeps its secrets in the CONVEX deployment (set via the Convex
# dashboard or `npx convex env set`), NOT in this file. The only thing the app
# needs here is the site URL it redirects back to.
SITE_URL=http://localhost:3000
# OAuth provider keys (if/when you add social login) live in Convex env, e.g.:
#   npx convex env set AUTH_GITHUB_ID ...    /  AUTH_GITHUB_SECRET ...

# --- AI model provider (the runAI() router) ---
# One cheap, fast model (GPT-4.1-mini / Gemini Flash class). Server-only.
# Swap provider in one place: convex/runAI.ts
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# OpenAI-compatible base URL. Leave default for OpenAI; point at a gateway to swap providers.
AI_BASE_URL=https://api.openai.com/v1

# --- Stripe (payments) — https://dashboard.stripe.com ---
# Use TEST keys (sk_test_..., pk_test_...) in dev. Webhook secret from `stripe listen`.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --- App ---
# Public base URL for share links + OG cards. http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
